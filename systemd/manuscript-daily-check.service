[Unit]
Description=书阁每日巡检（正向/负控召回回归 + 全量测试套件）
Documentation=file:///home/yourname/src/dsh-manuscript/scripts/daily-check.mjs
After=network.target

[Service]
# 2026-11-12：巡检结果不再单独推微信，改为写 ~/.dsh/logs/manuscript-daily-latest.md，
# 由每天 08:30 的早间提醒一并带出。
Environment=NO_PUSH=1
Type=oneshot
WorkingDirectory=/home/yourname/src/dsh-manuscript
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/node scripts/daily-check.mjs
# 巡检脚本自己会推微信；systemd 这里只收 stdout/journal，红了靠退出码标记
StandardOutput=journal
StandardError=journal
SyslogIdentifier=manuscript-daily
TimeoutStartSec=15min
